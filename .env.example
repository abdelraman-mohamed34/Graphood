# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Resend Email Service
RESEND_API_KEY=re_your_resend_api_key
RESEND_DEV_RECEIVER_EMAIL=dev@example.com
RESEND_FROM_EMAIL=Graphood <notifications@graphood.com>

# Security & API Encryption
API_KEY_ENCRYPTION_SECRET=your_32_character_encryption_secret

# Application URLs
NEXT_PUBLIC_APP_URL=https://www.graphood.com

# Kashier Payment Gateway
KASHIER_MERCHANT_ID=MID-0-0
KASHIER_SECRET_KEY=your_kashier_secret_key
KASHIER_API_KEY=your_kashier_api_key
KASHIER_CURRENCY=EGP
KASHIER_MODE=test
KASHIER_REDIRECT_URL=https://www.graphood.com/api/billing/kashier/callback
KASHIER_WEBHOOK_URL=https://www.graphood.com/api/webhooks/kashier

# AI Integrations
GEMINI_API_KEY=your_gemini_api_key

# Cron Workers Security
CRON_SECRET=your_cron_bearer_secret_token