            supabase
        );

        if (!system) {
            return developerJsonError(
                DeveloperApiErrorCodes.SYSTEM_NOT_FOUND,
                "System not found",
                404
            );
        }

        return developerJson(
            mapDeveloperContext(context, {
                system: {
