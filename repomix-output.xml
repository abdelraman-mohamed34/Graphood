export async function requireUser(locale: string) {
    const supabase = await createSupabaseServerClient();

    const { data: { user }, } = await supabase.auth.getUser();

    if (!user) {
        redirect(`/${locale}/login`);
    }

    return {
        supabase,
        user,
    };
}
