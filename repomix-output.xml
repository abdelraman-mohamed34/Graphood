                    </p>
                    <p>
                        <strong>Status:</strong>{" "}
                        {order.status}
                    </p>
                    <p>
                        <strong>Currency:</strong>{" "}
                        {order.currency}
                    </p>
                    <p>
                        <strong>Amount:</strong>{" "}
                        {order.amount}
                    </p>
