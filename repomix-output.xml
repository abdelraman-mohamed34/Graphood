        queryFn: () => fetchProfile(supabase, user!.id),
        enabled: !!user?.id,
        staleTime: Infinity,
    });

    return {
        user,
        profile,
        error: userError ?? profileError,
        isLoading: isUserLoading || isProfileLoading,
    };
