                                    title={membership.tenant.name}
                                    role={membership.role}
                                    image={getTenantLogo(membership.tenant)}
                                    href={getWorkspaceHref(membership.tenant.slug)}
                                />
                            </motion.div>
                        ))}

                        <motion.div
                            variants={itemVariants}
                            whileHover={{
                                y: -4,
                                transition: {
                                    duration: 0.2,
                                },
                            }}
                        >
                            <CreateWorkspaceCard />
                        </motion.div>
                    </motion.div>
                </motion.div>
            </main>
        </>
    );
}
