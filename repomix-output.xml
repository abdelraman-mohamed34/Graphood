    const isOwner = currentMembership?.role === "OWNER";
    const canTransfer =
        isOwner &&
        member.role === "ADMIN";

    return (
        <DropdownMenu>
            <DropdownMenuTrigger asChild>
                <button
                    className="rounded-md p-1 transition hover:bg-muted"
                >
                    <EllipsisVertical size={15} />
