import { requireUser } from "@/shared/lib/auth/requires/require-user";
import { redirect } from "next/navigation";

type AddTenantMemberType = {
    children: React.ReactNode;
    params: Promise<{
        locale: string;
        tenant_slug: string;
    }>;
};

export default async function AddTenantMemberLayout({
