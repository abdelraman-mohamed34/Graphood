            >
                {canTransfer && (
                    <TransferOwnership
                        member={member}
                    />
                )}

                <RemoveMember
                    member={member}
                    profileId={profileId}
                    removeMember={removeMember}
                />
            </DropdownMenuContent>
        </DropdownMenu>
    );
}
